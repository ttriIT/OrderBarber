{
  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=BarberBookingDB;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true;Encrypt=False"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Key": "REPLACE_WITH_USER_SECRETS",
    "Issuer": "BarberBookingSystem",
    "Audience": "BarberBookingSystem",
    "AccessTokenExpiryMinutes": 60,
    "RefreshTokenExpiryDays": 7
  },
  "Gemini": {
    "ApiKey": "REPLACE_WITH_USER_SECRETS"
  },
  "AllowedHosts": "*",
  "Https": {
    "EnableInProduction": true,
    "Port": 5001
  }
}

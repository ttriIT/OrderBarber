using Microsoft.AspNetCore.SignalR;
using Microsoft.AspNetCore.Authorization;
using System.Security.Claims;
using appcattoc.Services;
using appcattoc.DTOs.Chat;

namespace appcattoc.Hubs;

[Authorize]
public class ChatHub : Hub
{
    private readonly IChatService _chatService;

    public ChatHub(IChatService chatService)
    {
        _chatService = chatService;
    }

    public async Task SendMessage(int sessionId, string message)
    {
        var userId = int.Parse(Context.User?.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? "0");
        var userName = Context.User?.FindFirst("FullName")?.Value ?? "User";

        // Gửi message của user qua SignalR
        await Clients.Group($"session_{sessionId}").SendAsync("ReceiveMessage", new
        {
            SessionId = sessionId,
            SenderId = userId,
            SenderName = userName,
            Content = message,
            CreatedAt = DateTime.UtcNow
        });

        // Gọi ChatService để lưu vào DB và lấy AI response
        var request = new SendMessageRequest
        {
            SessionId = sessionId,
            Content = message
        };

        var result = await _chatService.SendMessageAsync(userId, request);

        if (result.Success && result.Data != null)
        {
            // Gửi AI response qua SignalR
            await Clients.Group($"session_{sessionId}").SendAsync("ReceiveMessage", new
            {
                SessionId = result.Data.SessionId,
                SenderId = result.Data.SenderId,
                SenderName = result.Data.SenderName,
                Content = result.Data.Content,
                CreatedAt = result.Data.CreatedAt
            });
        }
    }

    public async Task JoinSession(int sessionId)
    {
        await Groups.AddToGroupAsync(Context.ConnectionId, $"session_{sessionId}");
    }

    public async Task LeaveSession(int sessionId)
    {
        await Groups.RemoveFromGroupAsync(Context.ConnectionId, $"session_{sessionId}");
    }

    public override async Task OnConnectedAsync()
    {
        var userId = Context.User?.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (!string.IsNullOrEmpty(userId))
        {
            await Groups.AddToGroupAsync(Context.ConnectionId, $"user_{userId}");
        }
        await base.OnConnectedAsync();
    }

    public override async Task OnDisconnectedAsync(Exception? exception)
    {
        var userId = Context.User?.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (!string.IsNullOrEmpty(userId))
        {
            await Groups.RemoveFromGroupAsync(Context.ConnectionId, $"user_{userId}");
        }
        await base.OnDisconnectedAsync(exception);
    }
}


using Microsoft.EntityFrameworkCore;
using appcattoc.Data;
using appcattoc.DTOs.Chat;
using appcattoc.Models.Entities;
using appcattoc.Models.Enums;
using ChatMessageEntity = appcattoc.Models.Entities.ChatMessage;

namespace appcattoc.Services;

public interface IChatService
{
    Task<(bool Success, string Message, ChatSessionResponse? Data)> CreateChatSessionAsync(int userId, CreateChatSessionRequest request);
    Task<(bool Success, string Message, ChatMessageResponse? Data)> SendMessageAsync(int userId, SendMessageRequest request);
    Task<List<ChatSessionResponse>> GetUserChatSessionsAsync(int userId);
    Task<List<ChatMessageResponse>> GetSessionMessagesAsync(int sessionId, int userId);
}

public class ChatService : IChatService
{
    private readonly BarberDbContext _context;
    private readonly IConfiguration _configuration;

    public ChatService(BarberDbContext context, IConfiguration configuration)
    {
        _context = context;
        _configuration = configuration;
    }

    public async Task<(bool Success, string Message, ChatSessionResponse? Data)> CreateChatSessionAsync(
        int userId, CreateChatSessionRequest request)
    {
        if (!Enum.TryParse<ChatSessionType>(request.Type, out var sessionType))
        {
            return (false, "Invalid chat session type", null);
        }

        var chatSession = new ChatSession
        {
            User1_Id = userId,
            User2_Id = request.User2_Id,
            Type = sessionType,
            CreatedAt = DateTime.UtcNow
        };

        _context.ChatSessions.Add(chatSession);
        await _context.SaveChangesAsync();

        var response = new ChatSessionResponse
        {
            Id = chatSession.Id,
            User1_Id = chatSession.User1_Id,
            User2_Id = chatSession.User2_Id,
            Type = chatSession.Type.ToString(),
            CreatedAt = chatSession.CreatedAt,
            RecentMessages = new List<ChatMessageResponse>()
        };

        return (true, "Chat session created successfully", response);
    }

    public async Task<(bool Success, string Message, ChatMessageResponse? Data)> SendMessageAsync(
        int userId, SendMessageRequest request)
    {
        var session = await _context.ChatSessions
            .FirstOrDefaultAsync(s => s.Id == request.SessionId);

        if (session == null)
        {
            return (false, "Chat session not found", null);
        }

        // Verify user is part of the session
        if (session.Type == ChatSessionType.Human_to_Human && 
            session.User1_Id != userId && session.User2_Id != userId)
        {
            return (false, "You are not a participant in this chat session", null);
        }

        if (session.Type == ChatSessionType.Human_to_AI && session.User1_Id != userId)
        {
            return (false, "You are not authorized to send messages in this session", null);
        }

        var message = new ChatMessageEntity
        {
            SessionId = request.SessionId,
            SenderId = userId,
            Content = request.Content,
            IsImage = request.IsImage,
            IsAI = false,
            CreatedAt = DateTime.UtcNow
        };

        _context.ChatMessages.Add(message);
        session.UpdatedAt = DateTime.UtcNow;
        await _context.SaveChangesAsync();

        var sender = await _context.Users.FindAsync(userId);

        var response = new ChatMessageResponse
        {
            Id = message.Id,
            SessionId = message.SessionId,
            SenderId = message.SenderId ?? 0,
            SenderName = sender?.FullName ?? "Unknown",
            Content = message.Content,
            IsImage = message.IsImage,
            CreatedAt = message.CreatedAt
        };

        // Simple AI response without OpenAI
        if (session.Type == ChatSessionType.Human_to_AI)
        {
            var aiResponse = GetSimpleAIResponse(request.Content);
            
            var aiMessage = new ChatMessageEntity
            {
                SessionId = request.SessionId,
                SenderId = null,
                Content = aiResponse,
                IsImage = false,
                IsAI = true,
                CreatedAt = DateTime.UtcNow
            };

            _context.ChatMessages.Add(aiMessage);
            await _context.SaveChangesAsync();
        }

        return (true, "Message sent successfully", response);
    }

    public async Task<List<ChatSessionResponse>> GetUserChatSessionsAsync(int userId)
    {
        return await _context.ChatSessions
            .Where(s => s.User1_Id == userId || s.User2_Id == userId)
            .Include(s => s.User1)
            .Include(s => s.User2)
            .Include(s => s.Messages.OrderByDescending(m => m.CreatedAt).Take(1))
            .OrderByDescending(s => s.UpdatedAt ?? s.CreatedAt)
            .Select(s => new ChatSessionResponse
            {
                Id = s.Id,
                User1_Id = s.User1_Id,
                User2_Id = s.User2_Id,
                PartnerName = s.Type == ChatSessionType.Human_to_AI 
                    ? "AI Stylist" 
                    : (s.User1_Id == userId 
                        ? (s.User2 != null ? s.User2.FullName : "Unknown") 
                        : (s.User1 != null ? s.User1.FullName : "Unknown")) ?? "Unknown",
                PartnerAvatar = (s.Type == ChatSessionType.Human_to_AI 
                    ? "https://cdn-icons-png.flaticon.com/512/4712/4712027.png" 
                    : (s.User1_Id == userId 
                        ? (s.User2 != null ? s.User2.AvatarUrl : "") 
                        : (s.User1 != null ? s.User1.AvatarUrl : ""))) ?? "",
                Type = s.Type.ToString(),
                CreatedAt = s.CreatedAt,
                RecentMessages = s.Messages.Select(m => new ChatMessageResponse
                {
                    Id = m.Id,
                    SessionId = m.SessionId,
                    SenderId = m.SenderId ?? 0,
                    SenderName = "User", // Simplified for list view
                    Content = m.Content,
                    IsImage = m.IsImage,
                    CreatedAt = m.CreatedAt
                }).ToList()
            })
            .ToListAsync();
    }

    public async Task<List<ChatMessageResponse>> GetSessionMessagesAsync(int sessionId, int userId)
    {
        var session = await _context.ChatSessions.FindAsync(sessionId);
        if (session == null || (session.User1_Id != userId && session.User2_Id != userId))
        {
            return new List<ChatMessageResponse>();
        }

        return await _context.ChatMessages
            .Where(m => m.SessionId == sessionId)
            .Include(m => m.Sender)
            .OrderBy(m => m.CreatedAt)
            .Select(m => new ChatMessageResponse
            {
                Id = m.Id,
                SessionId = m.SessionId,
                SenderId = m.SenderId ?? 0,
                SenderName = m.IsAI ? "AI Stylist" : (m.Sender != null ? m.Sender.FullName : "Unknown"),
                Content = m.Content,
                IsImage = m.IsImage,
                CreatedAt = m.CreatedAt
            })
            .ToListAsync();
    }

    // Simple AI response generator (can be replaced with real AI later)
    private string GetSimpleAIResponse(string userMessage)
    {
        var lowerMessage = userMessage.ToLower();
        
        if (lowerMessage.Contains("kiểu tóc") || lowerMessage.Contains("hair"))
        {
            return "Tôi có thể tư vấn kiểu tóc phù hợp với khuôn mặt của bạn. Bạn có thể cho tôi biết khuôn mặt bạn thuộc dạng nào? (tròn, vuông, dài, trái tim)";
        }
        else if (lowerMessage.Contains("giá") || lowerMessage.Contains("price"))
        {
            return "Giá dịch vụ cắt tóc của chúng tôi từ 100,000 - 500,000 VNĐ tùy theo kiểu tóc. Bạn có muốn xem bảng giá chi tiết không?";
        }
        else if (lowerMessage.Contains("đặt lịch") || lowerMessage.Contains("booking"))
        {
            return "Bạn có thể đặt lịch ngay trong ứng dụng. Vui lòng chọn barber, dịch vụ và thời gian phù hợp.";
        }
        else
        {
            return "Cảm ơn bạn đã liên hệ! Tôi là trợ lý AI của Smart Barber. Tôi có thể giúp bạn tư vấn kiểu tóc, giá cả, và đặt lịch. Bạn cần tư vấn gì?";
        }
    }
}
